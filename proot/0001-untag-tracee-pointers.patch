+/**
+ * Strip the pointer tag (top byte) from the tracee's @address.  Since
+ * Android 11, Bionic tags heap pointers on arm64 (TBI) but the kernel
+ * rejects tagged addresses in ptrace(PEEK/POKEDATA) and process_vm_*.
+ */
+static inline word_t untag_address(word_t address)
+{
+#if defined(__aarch64__)
+	return address & 0x00FFFFFFFFFFFFFFULL;
+#else
+	return address;
+#endif
+}
